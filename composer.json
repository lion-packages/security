{
    "name": "lion/security",
    "description": "Library created with the function of implementing AES, RSA and JWT security features for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://dev.lion-packages.com",
    "keywords": [
        "lion",
        "security",
        "lion-security"
    ],
    "support": {
        "issues": "https://github.com/lion-packages/security/issues",
        "source": "https://github.com/lion-packages/security"
    },
    "autoload": {
        "psr-4": {
            "Lion\\Security\\": "src/LionSecurity/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.1",
        "vlucas/valitron": "^1.4"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "lion/test": "^3.2",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11 || ^4.0",
        "phpunit/phpunit": "^12.0",
        "overtrue/phplint": "^9.5",
        "infection/infection": "^0.29.14 || ^0.31.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
